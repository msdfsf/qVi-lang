{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "qvi",
      "camelcase": "qVi",
      "title": "qVi",
      "scope": "source.qvi",
      "file-types": [
        "qvi",
        "qv"
      ],
      "injection-regex": "^qvi$",
      "class-name": "TreeSitterQvi"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Tree Sitter for qVi language.",
    "authors": [
      {
        "name": "Me",
        "email": "@",
        "url": ""
      }
    ],
    "links": {
      "repository": "https://github.com/msdfsf/qVi-lang/tree/main/tools/tree-sitter-qvi",
      "funding": ""
    }
  },
  "bindings": {
    "c": true,
    "go": false,
    "java": false,
    "node": false,
    "python": false,
    "rust": false,
    "swift": false,
    "zig": false
  }
}
