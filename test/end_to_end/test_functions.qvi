// =============================================================================
// 1. Basic Functions
// =============================================================================

// 1.1 Zero parameters, no return value
puk: () {
    "puk";
}
puk();
#test "puk"

// 1.2 Zero parameters, return value
answer: () -> i32 {
    return 69;
}
"%v" answer();
#test "69"

// 1.3 One parameter, no return value
echo: (in: i32) {
    "%v" in;
}
echo(67);
#test "67"

// 1.4 Two parameters, return value
add: (a: i32, b: i32) -> i32 {
    return a + b;
}
"%v\n" add(3, 4);
#test "7\n"

// 1.5 Multiple parameters, return value
volume: (w: i32, h: i32, d: i32) -> i32 {
    return w * h * d;
}
"%v\n" volume(2, 3, 4);
#test "24\n"


// =============================================================================
// 2. Control Flow in Functions
// =============================================================================

// 2.1 Multiple early returns
classify: (n: i32) -> i32 {
    if n < 0 : return -1;
    if n == 0 : return 0;
    return 1;
}
"%v, %v, %v\n" classify(-5), classify(0), classify(5);
#test "-1, 0, 1\n"


// =============================================================================
// 3. Recursion
// =============================================================================

// 3.1 Factorial
fact: (n: i32) -> i32 {
    if n <= 1 : return 1;
    return n * fact(n - 1);
}
"%v\n" fact(5);
#test "120\n"

// 3.2 Fibonacci
fib: (n: i32) -> i32 {
    if n <= 1 : return n;
    return fib(n - 1) + fib(n - 2);
}
"%v\n" fib(10);
#test "55\n"


// =============================================================================
// 4. Overloading
// =============================================================================

// 4.1 Exact Match on Primitive Types (i32 vs f32 vs i64)
logValue: (x: i32) {
    "i32: %v\n" x;
}

logValue: (x: f32) {
    "f32: %v\n" x;
}

logValue: (x: i64) {
    "i64: %v\n" x;
}

logValue(69 -> i32);
logValue(3.5 -> f32);
logValue(10000000000);
#test "i32: 69\nf32: 3.5\ni64: 10000000000\n"


// 4.2 Overloading by Arity (1 vs 2 vs 3 parameters)
calculate: (a: i32) -> i32 {
    return a * 10;
}

calculate: (a: i32, b: i32) -> i32 {
    return a + b;
}

calculate: (a: i32, b: i32, c: i32) -> i32 {
    return a * b + c;
}

r1: i32 = calculate(5);
r2: i32 = calculate(10, 20);
r3: i32 = calculate(3, 4, 10);
"%v, %v, %v\n" r1, r2, r3;
#test "50, 30, 22\n"


// 4.3 Pointer vs. Value Overloading (i32 vs i32*)
inspect: (x: i32) {
    "by value: %v\n" x;
}

inspect: (p: i32^) {
    "by pointer: %v\n" ^p;
}

val: i32 = 100;
inspect(val);   // Calls value overload
inspect(&val);  // Calls pointer overload
#test "by value: 100\nby pointer: 100\n"


// 4.4 Array vs. Slice vs. Scalar Overloading (i32[4] vs i32[const] vs i32)
processData: (x: i32) {
    "scalar: %v\n" x;
}

processData: (arr: i32[4]) {
    "exact array[4]: %v\n" arr;
}

processData: (s: i32[const]) {
    "generic slice: %v\n" s;
}

single: i32 = 99;
fixed4: i32[4] = [1, 2, 3, 4];
fixed3: i32[3] = [10, 20, 30]; // Non-4 array falls back to slice overload!

processData(single);
processData(fixed4);
processData(fixed3);
#test "scalar: 99\nexact array[4]: [1, 2, 3, 4]\ngeneric slice: [10, 20, 30]\n"


// 4.5 Distinct Struct Type Overloading
Point: struct {
    x: i32;
    y: i32;
}

Size: struct {
    w: i32;
    h: i32;
}

describe: (p: Point) {
    "Point(%v, %v)\n" p.x, p.y;
}

describe: (s: Size) {
    "Size(%v, %v)\n" s.w, s.h;
}

pt: Point;
pt.x = 10;
pt.y = 20;

sz: Size;
sz.w = 1920;
sz.h = 1080;

describe(pt);
describe(sz);
#test "Point(10, 20)\nSize(1920, 1080)\n"


// 4.6 Return-Type Chaining with Overloads
scale: (x: i32) -> i32 {
    return x * 2;
}

scale: (f: f32) -> f32 {
    return f * 2.0;
}

iRes: i32 = scale(scale(5));
fRes: f32 = scale(scale(2.5 -> f32));
"%v, %v\n" iRes, fRes;
#test "20, 10\n"


// 4.7 Implicit Conversion / Promotion Ranking
displayPromoted: (val: i64) {
    "promoted to i64: %v\n" val;
}

displayPromoted: (val: f64) {
    "promoted to f64: %v\n" val;
}

smallInt: i16 = 50;
smallFloat: f32 = 12.5;

displayPromoted(smallInt);   // i16 prefers i64 over f64
displayPromoted(smallFloat); // f32 prefers f64 over i64
#test "promoted to i64: 50\npromoted to f64: 12.5\n"


// =============================================================================
// 5. Forward References
// =============================================================================

// 5.1 Call a function defined later
early: i32 = later(10);
"%v\n" early;

later: (x: i32) -> i32 {
    return x * 2;
}
#test "20\n"
