// =============================================================================
// 1. Basic Enums
// =============================================================================

// 1.1 Default underlying type, auto-increment from zero
Color: enum {
    Red,
    Green,
    Blue
}
"%v, %v, %v" Color.Red, Color.Green, Color.Blue;
#test "Red, Green, Blue"

// 1.2 Explicit values with auto-increment + implicit int conversion
HttpStatus: enum {
    Ok = 200,
    Created,
    BadRequest = 400,
    NotFound = 404
}
"%v, %v, %v, %v" HttpStatus.Ok, HttpStatus.Created, HttpStatus.BadRequest, HttpStatus.NotFound;
#test "Ok, Created, BadRequest, NotFound"

// 1.3 Negative explicit values with auto-increment
Status: enum {
    Error = -1,
    Idle,
    Ready
}
"%{#v}, %{#v}, %{#v}\n" Status.Error, Status.Idle, Status.Ready;
#test "Error(-1), Idle(0), Ready(1)\n"

// 1.4 Custom underlying type (u8)
LogLevel: enum : u8 {
    Debug,
    Info,
    Warning,
    Error
}
"%v" LogLevel.Error -> i64;
#test "3"

// 1.5 Enum used in an arithmetic expression
Direction: enum {
    Up,
    Right,
    Down,
    Left
}
n: i64 = Direction.Down + 10;
"%v" n;
#test "12"
