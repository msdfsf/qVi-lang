// 1. Mixed Field Widths & Alignment Padding (u8, i32, u8, i64)
Mixed: struct {
    flag1: u8;
    val: i32;
    flag2: u8;
    big: i64;
}

m: Mixed;
m.flag1 = 1;
m.val = 12345;
m.flag2 = 2;
m.big = 9876543210;

"%v\n" m;
#test "{flag1: 1, val: 12345, flag2: 2, big: 9876543210}\n"


// 2. 2D/3D Math Structs & Arithmetic on Fields
Vec3: struct {
    x: f32;
    y: f32;
    z: f32;
}

v: Vec3;
v.x = 1.0;
v.y = 2.0;
v.z = 3.0;

lenSq: f32 = v.x * v.x + v.y * v.y + v.z * v.z;
"lenSq: %v\n" lenSq;
#test "lenSq: 14\n"


// 3. Multi-Level Deeply Nested Structs (a.b.c.d)
Position: struct {
    x: i32;
    y: i32;
}

Stats: struct {
    hp: i32;
    maxHp: i32;
}

Player: struct {
    id: i32;
    pos: Position;
    stats: Stats;
}

p: Player;
p.id = 101;
p.pos.x = 50;
p.pos.y = 80;
p.stats.hp = 95;
p.stats.maxHp = 100;

"Player %v at (%v, %v) has %v/%v HP\n" p.id, p.pos.x, p.pos.y, p.stats.hp, p.stats.maxHp;
#test "Player 101 at (50, 80) has 95/100 HP\n"



// 4. Fixed-Size Arrays Embedded Inside Structs
BufferContainer: struct {
    data: i32[4];
    activeCount: i32;
}

b: BufferContainer;
b.data[:] = [10, 20, 30, 40];
b.activeCount = 4;

b.data[1] = 999;

"%v, count: %v\n" b.data, b.activeCount;
#test "[10, 999, 30, 40], count: 4\n"


// 5. Array of Structs with Loop Accumulation (Inventory System)
Item: struct {
    price: i32;
    qty: i32;
}

inventory: Item[3];
inventory[0].price = 10; inventory[0].qty = 2; // 20
inventory[1].price = 25; inventory[1].qty = 4; // 100
inventory[2].price = 50; inventory[2].qty = 1; // 50

totalValue: i32 = 0;
loop 0 : 2 at i {
    totalValue = totalValue + (inventory[i].price * inventory[i].qty);
}

"Total inventory: %v\n" totalValue;
#test "Total inventory: 170\n"


// 6. Struct Field Mutation Through a Struct Pointer
Node: struct {
    value: i32;
    flag: u8;
}

n: Node;
n.value = 10;
n.flag = 1;

pNode: Node^ = &n;
pNode.value = 500;
pNode.flag = 0;

"%v\n" n;
#test "{value: 500, flag: 0}\n"


// 7. Swapping Two Struct Instances
Pair: struct {
    first: i32;
    second: i32;
}

p1: Pair; p1.first = 1; p1.second = 2;
p2: Pair; p2.first = 8; p2.second = 9;

tmpPair: Pair = p1;
p1 = p2;
p2 = tmpPair;

"p1 = %v, p2 = %v\n" p1, p2;
#test "p1 = {first: 8, second: 9}, p2 = {first: 1, second: 2}\n"
