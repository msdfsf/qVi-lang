// =============================================================================
// 1. Basic Struct Literal Initialization & Re-Assignment
// =============================================================================


// 1.1 Direct definition with a struct literal
Point: struct {
    x: i32;
    y: i32;
}

pt: Point = {
    x: 10,
    y: 20
};
"%v\n" pt;
#test "{x: 10, y: 20}\n"

// 1.2 Re-assigning an existing struct variable with a new struct literal
Point: struct {
    x: i32;
    y: i32;
}

pt: Point;
pt = {
    x: 100,
    y: 200
};
"%v\n" pt;
#test "{x: 100, y: 200}\n"

// 1.3 Struct Literal with Mixed Widths & Padding (u8, i32, u8, i64)
Mixed: struct {
    flag1: u8;
    val: i32;
    flag2: u8;
    big: i64;
}

m: Mixed = {
    flag1: 1,
    val: 12345,
    flag2: 2,
    big: 9876543210
};
"%v\n" m;
#test "{flag1: 1, val: 12345, flag2: 2, big: 9876543210}\n"


// 1.4 Struct Literals Containing Dynamic / Runtime Expressions
Point: struct {
    x: i32;
    y: i32;
}

baseX: i32 = 10;
baseY: i32 = 20;

dynamicPt: Point = {
    x: baseX + 5,
    y: baseY * 2
};
"%v\n" dynamicPt, dynamicPt;
#test "{x: 15, y: 40}\n"


// 1.5 Nested Struct Literal Initializations
Vec2: struct {
    x: i32;
    y: i32;
}

Stats: struct {
    hp: i32;
    maxHp: i32;
}

Player: struct {
    id: i32;
    pos: Vec2;
    stats: Stats;
}

player: Player = {
    id: 101,
    pos: {
        x: 50,
        y: 80
    },
    stats: {
        hp: 95,
        maxHp: 100
    }
};

"%v\n" player;
#test "{id: 101, pos: {x: 50, y: 80}, stats: {hp: 95, maxHp: 100}}\n"









