// 0.1 Endless loop
loop {
    "puk";
    break;
}
#test "puk"


// =============================================================================
// 1. Range Loops
// =============================================================================

// 1.1 Inferred index variable
loop 0 : 5 at i {
    "%v " i;
}
#test "0 1 2 3 4 5 "

// 1.2 Explicit index type
loop 0 : 5 at i: u64 {
    "%v " i;
}
#test "0 1 2 3 4 5 "

// 1.3 Pre-declared index variable passed by reference
i: u64 = 0;
loop 0 : 5 at &i {
    "%v " i;
}
#test "0 1 2 3 4 5 "

// 1.4 Single-iteration range
loop 3 : 3 at i {
    "%v " i;
}
#test "3 "

// 1.5 Iteration with By-Value Item Alias and Index
loop 0 : 5 as val at i {
    "%v " val == i;
}
#test "1 1 1 1 1 1 "

// 1.6 Implicit start
loop :5 at i {
    "%v " i;
}
#test "0 1 2 3 4 5 "

// =============================================================================
// 2. Range Loops: Step Variations (start : step : end)
// =============================================================================

// 2.1 Explicit positive step (+2)
loop 0 : 2 : 8 at i {
    "%v " i;
}
#test "0 2 4 6 8 "

// 2.2 Reverse loop with negative step (-1)
loop 5 : -1 : 0 at i {
    "%v " i;
}
#test "5 4 3 2 1 0 "

// 2.3 Reverse loop with custom negative step (-3)
loop 10 : -3 : 1 at i {
    "%v " i;
}
#test "10 7 4 1 "

// 2.4 Range loop without index variable
counter: i32 = 0;
loop 0 : 3 {
    counter = counter + 10;
}
"%v" counter;
#test "40"


// =============================================================================
// 3. Condition Loops (loop <condition>)
// =============================================================================

// 3.1 Basic condition loop
count: i32 = 0;
loop count < 4 {
    "%v " count;
    count = count + 1;
}
#test "0 1 2 3 "

// 3.2 Condition loop with automatic index counter
n: i32 = 10;
loop n > 0 at i {
    "%v" i;
    n = n - 4;
}
#test "012"


// =============================================================================
// 4. Arrays
// =============================================================================

// 4.1 Array iteration with Index only
arr: i32[4] = [10, 20, 30, 40];
loop arr at i {
    "%v " i;
}
#test "0 1 2 3 "

// 4.2 Array iteration with By-Value Item Alias
arr: i32[4] = [10, 20, 30, 40];
loop arr as val {
    "%v " val;
}
#test "10 20 30 40 "

// 4.3 Array iteration with Item and Index
arr: i32[3] = [100, 200, 300];
loop arr as val at i {
    "%v:%v " i, val;
}
#test "0:100 1:200 2:300 "

// 4.4 Array iteration with By-Reference Item Alias
arr: i32[3] = [1, 2, 3];
loop arr as &item {
    ^item = ^item * 10;
}
"%v" arr;
#test "[10, 20, 30]"

// 4.5 Array iteration with By-Reference Item and Index
arr: i32[4] = [0, 0, 0, 0];
loop arr as &item at i {
    ^item = (i + 1) * 5;
}
"%v" arr;
#test "[5, 10, 15, 20]"


// =============================================================================
// 5. Slices
// =============================================================================

// 5.1 Constant slice iteration (as item)
slice: i32[const] = [5, 10, 15, 20];
loop slice as item {
    "%v " item;
}
#test "5 10 15 20 "

// 5.2 Slice iteration with Index and Item
slice: i32[const] = [9, 8, 7];
loop slice as val at idx {
    "%v:%v " idx, val;
}
#test "0:9 1:8 2:7 "

// 5.3 Float array iteration
floats: f32[3] = [1.5, 2.5, 3.5];
loop floats as f {
    "%v " f;
}
#test "1.5 2.5 3.5 "


// =============================================================================
// 6. Nested Loops
// =============================================================================

// 6.1 Nested range loops
loop 0 : 1 at x {
    loop 0 : 2 at y {
        "(%v,%v) " x, y;
    }
}
#test "(0,0) (0,1) (0,2) (1,0) (1,1) (1,2) "

// 6.2 Nested Array + Range loop
data: i32[2] = [10, 20];
loop data as val {
    loop 1 : 2 at count {
        "%v " val * count;
    }
}
#test "10 20 20 40 "


// =============================================================================
// 7. MISC
// =============================================================================

// 7.1 Even / Odd filtering inside loop
loop 0 : 5 at i {
    if (i % 2 == 0) {
        "E%v " i;
    } else {
        "O%v " i;
    }
}
#test "E0 O1 E2 O3 E4 O5 "

// 7.2 Accumulator sum over array
numbers: i32[4] = [5, 15, 25, 35];
total: i32 = 0;
loop numbers as n {
    total = total + n;
}
"%v" total;
#test "80"
