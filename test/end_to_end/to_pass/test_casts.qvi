// =============================================================================
// 1. Scalar Integer Conversions (Upcasts, Downcasts, Sign Conversions)
// =============================================================================

// 1.1 Integer Upcast & Sign Extension (i8 -> i64)
smallNeg: i8 = -15;
bigNeg: i64 = smallNeg -> i64;
"%v\n" bigNeg;
#test "-15\n"

// 1.2 Unsigned Integer Upcast (u8 -> u32)
byteVal: u8 = 200;
wideVal: u32 = byteVal -> u32;
"%v\n" wideVal;
#test "200\n"

// 1.3 Integer Truncation / Narrowing (i64 -> i32 -> u8)
largeNum: i64 = 300;
truncated: u8 = largeNum -> u8; // 300 %v 256 = 44
"%v\n" truncated;
#test "44\n"

// 1.4 Unsigned to Signed Reinterpretation (u32 -> i32)
allOnes: u32 = 4294967295;
signedVal: i32 = allOnes -> i32;
"%v\n" signedVal;
#test "-1\n"


// =============================================================================
// 2. Float <-> Integer Conversions
// =============================================================================

// 2.1 Float to Integer Truncation (f32 -> i32)
fVal: f32 = 9.85;
iVal: i32 = fVal -> i32;
"%v\n" iVal;
#test "9\n"

// 2.2 Negative Float to Integer Truncation (f64 -> i32)
negFloat: f64 = -42.99;
negInt: i32 = negFloat -> i32;
"%v\n" negInt;
#test "-42\n"

// 2.3 Integer to Float Promotion (i32 -> f32)
intNum: i32 = 125;
floatNum: f32 = intNum -> f32;
"%v\n" floatNum;
#test "125\n"

// 2.4 Double to Float Precision Narrowing (f64 -> f32)
doubleVal: f64 = 3.5;
singleVal: f32 = doubleVal -> f32;
"%v\n" singleVal;
#test "3.5\n"


// =============================================================================
// 3. Vector / Array Batch Casts (vec_cast)
// =============================================================================

// 3.1 Float Vector to Integer Array Truncation (f32[4] -> i32[4])
floatVec: f32[4] = [1.1, 2.9, 3.5, 4.0];
intArr: i32[4] = floatVec;
"%v\n" intArr;
#test "[1, 2, 3, 4]\n"

// 3.2 Integer Vector to Float Array Promotion (i32[3] -> f32[3])
intVec: i32[3] = [10, 20, 30];
floatArr: f32[3] = intVec;
"%v\n" floatArr;
#test "[10, 20, 30]\n"

// 3.3 Int64 Array Downcast to Int32 Array (i64[4] -> i32[4])
bigInts: i64[4] = [100, 200, 300, 400];
smallInts: i32[4] = bigInts;
"%v\n" smallInts;
#test "[100, 200, 300, 400]\n"

// 3.4 Unsigned Bytes to Int32 Vector Promotion (u8[4] -> i32[4])
bytes: u8[4] = [255, 128, 64, 0];
promotedInts: i32[4] = bytes;
"%v\n" promotedInts;
#test "[255, 128, 64, 0]\n"


// =============================================================================
// 4. Casts in Vector Math & Chained Expressions
// =============================================================================

// 4.1 Floating-point math with final integer array cast
arrA: i32[4] = [1.0, 2.0, 3.0, 4.0] * 2.5 + 0.5; // (f64 math -> cast to i32)
"%v\n" arrA;
#test "[3, 5, 8, 10]\n"

// 4.2 Mixed vector-scalar expression with length cast
boardLen: u64 = 100;
limit: i32 = (boardLen - 10 - 2) -> i32;
"%v\n" limit;
#test "88\n"


// =============================================================================
// 5. Function Calls with Cast Arguments
// =============================================================================

// 5.1 Passing a casted integer to a function expecting a float
printScaledFloat: (val: f32) {
    scaled: f32 = val * 2.0;
    "%v\n" scaled;
}

num: i32 = 21;
printScaledFloat(num -> f32);
#test "42\n"


// 5.2 Passing a casted vector to a function expecting a const slice
printIntSlice: (s: i32[const]) {
    "%v\n" s;
}

rawFloats: f32[3] = [1.9, 2.1, 3.8];
// Casts to local buffer and passes as i32[const] slice
castedInts: i32[3] = rawFloats;
printIntSlice(castedInts);
#test "[1, 2, 3]\n"
