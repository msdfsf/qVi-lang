// =============================================================================
// Parser-sync (error recovery) end-to-end tests.
//
// Each section contains independent errors; the parser is expected to sync
// and keep parsing after each one, so all of them accumulate in the
// AstContext. The quoted value after '#test' is the expected diagnostic
// list: comma separated 'E<code>' / 'W<code>' entries (E = error, W =
// warning, code = positive magnitude of the Err/Wrn value), order matters.
// Optional '@line' asserts the 1-based line number counted from the first
// line of the section (the blank line after the previous '#test' is line 1).
// =============================================================================

// =============================================================================
// 1. Global Scope Recovery (simple)
// =============================================================================

// 1.1 Missing rvalues, valid declarations in between
a: i32 = 1;
b: i32 = ;
c: i32 = 2;
d: i32 = ;
#test "E7,E7"

// 1.2 Stray tokens at global scope, with line tracking
x: i32 = 10;
)
y: i32 = 20;
)
#test "E7@4,E7@6"

// 1.3 Parse errors do not stop validation of the rest of the unit
a: i32 = 1;
b: i32 = ;
c: i32 = 2;
undefinedFnc();
#test "E7,E69"

// 1.4 Extra closing brace at global scope
x: i32 = 1;
}
#test "E7"


// =============================================================================
// 2. Recovery Inside Function Bodies
// =============================================================================

// 2.1 Missing rvalues inside a function body, body scope stays intact
f: () {
    a: i32 = ;
    b: i32 = 2;
    c: i32 = ;
}
g: () {
    return;
}
#test "E7,E7"

// 2.2 Line tracking of errors reported inside a function body
f: () {
    a: i32 = 1;
    b: i32 = ;
    c: i32 = 2;
    d: i32 = ;
}
#test "E7@5,E7@7"


// =============================================================================
// 3. Recovery Inside Loops and Branches
// =============================================================================

// 3.1 Missing rvalues inside a loop body
loop 0 : 10 at i {
    a: i32 = ;
    b: i32 = 2;
    c: i32 = ;
}
#test "E7,E7"

// 3.2 Missing rvalue inside an if body, following statements still parse
if 1 > 0 {
    a: i32 = ;
}
b: i32 = 5;
c: i32 = ;
#test "E7,E7"


// =============================================================================
// 4. Unterminated Constructs (end of file)
// =============================================================================

// 4.1 Missing rvalue followed by an unterminated code block
f: () {
    a: i32 = ;
#test "E7,E2"


// =============================================================================
// 5. Type Declarations and Conversions
// =============================================================================

// 5.1 Struct parses, enum with non-integer member type fails, then a broken assignment
p: struct {
    x: i32;
    y: i32;
}
broken: enum : f64 {
    A
}
num: i32 = 0;
num = "text";
#test "E16,E11"

// 5.2 Array initializer count mismatch is reported after all parse errors
x: i32 = 10;
)
arr: i32[4] = [1, 2, 3];
#test "E7,E11"

// 5.3 Compile time division by zero in an embed initializer
c: embed i32 = 10 / 0;
#test "E62"

// 5.4 String literal widened to a wider element type, warning only
wideStr: u16[8] = "text";
#test "W4"

// 5.5 Parse error first, warning later
wideStr: u16[8] = "text";
x: i32 = 10;
)
#test "E7,W4"


// =============================================================================
// 6. Complex Mix
// =============================================================================

// 6.1 Errors across constructs: global scope, function body, loop body, validation
x: i32 = 10;
)
f: () {
    a: i32 = ;
}
loop 0 : 10 at i {
    b: i32 = ;
}
undefinedFnc();
#test "E7,E7,E7,E69"
